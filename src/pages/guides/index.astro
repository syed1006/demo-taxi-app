---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import PageLayout from "../../layouts/PageLayout.astro";
import ItemListSchema from "../../components/seo/ItemListSchema.astro";
import { optionalContentImage } from "../../data/images";
import { withBase } from "../../lib/url";

const path = "/guides/";
const title = "Bangalore Travel Guides — Routes, Timings & Trip Planning";
const description =
	"Practical travel guides from Bangalore's cab drivers: Mysore expressway tips, Nandi Hills sunrise timings, airport pickups, Coorg itineraries & Tirupati planning.";

const guides = (await getCollection("guides")).sort(
	(a, b) => a.data.order - b.data.order
);
---

<PageLayout
	{title}
	{description}
	{path}
	trail={[{ name: "Travel Guides" }]}
	waMessage="Hi! I'm planning a trip from Bangalore — can you help me with a cab?"
	ctaTitle="Read enough? Let's plan it"
>
	<section class="px-4 sm:px-6 lg:px-8 py-10">
		<div class="max-w-6xl mx-auto">
			<div class="max-w-3xl mb-10">
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground mb-4">
					Bangalore Travel Guides
				</h1>
				<p class="text-lg text-muted-foreground">
					Not brochures — field notes. Our drivers do these roads every week;
					these guides are what they'd tell a friend: real timings, real costs,
					and the mistakes to skip.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					guides.map((guide) => {
						const hero = optionalContentImage(guide.data.heroImage);
						const words = guide.body?.split(/\s+/).length ?? 0;
						const minutes = Math.max(2, Math.round(words / 200));
						return (
							<a
								href={withBase(`/guides/${guide.id}/`)}
								class="group flex flex-col overflow-hidden rounded-xl border-2 bg-card transition-all duration-300 hover:border-orange-200 hover:shadow-xl dark:hover:border-orange-800"
							>
								{hero ? (
									<Image
										src={hero}
										alt={guide.data.title}
										widths={[400, 800]}
										sizes="360px"
										format="webp"
										quality={72}
										loading="lazy"
										class="h-40 w-full object-cover transition-transform duration-500 group-hover:scale-105"
									/>
								) : (
									<div class="flex h-40 w-full items-center justify-center bg-gradient-to-br from-orange-500 via-red-500 to-pink-600">
										<Icon name="lucide:map" class="h-10 w-10 text-white/80" />
									</div>
								)}
								<div class="flex flex-1 flex-col p-5">
									<h2 class="font-bold leading-snug text-foreground transition-colors group-hover:text-orange-500">
										{guide.data.title}
									</h2>
									<p class="mt-2 text-sm text-muted-foreground line-clamp-3">
										{guide.data.description}
									</p>
									<p class="mt-auto pt-3 flex items-center gap-1.5 text-xs font-semibold text-orange-500">
										<Icon name="lucide:clock" class="h-3.5 w-3.5" />
										{minutes} min read
										<span class="ml-auto">Read the guide →</span>
									</p>
								</div>
							</a>
						);
					})
				}
			</div>
		</div>
	</section>

	<ItemListSchema
		name="Bangalore Travel Guides"
		items={guides.map((guide) => ({
			name: guide.data.title,
			path: `/guides/${guide.id}/`,
		}))}
	/>
</PageLayout>
