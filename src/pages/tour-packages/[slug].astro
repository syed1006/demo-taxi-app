---
import { Image, getImage } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/PageHero.astro";
import FareTable from "../../components/FareTable.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import PackageCard from "../../components/PackageCard.astro";
import { Icon } from "astro-icon/components";
import type { TourPackage } from "../../data/route-types";
import { PACKAGES } from "../../data/packages";
import { ROUTES, routePath } from "../../data/routes";
import { RATE_CARD } from "../../data/rate-card";
import { formatINR } from "../../lib/fare";
import { withBase } from "../../lib/url";
import { SITE } from "../../data/site";

export function getStaticPaths() {
	return PACKAGES.map((pkg) => ({
		params: { slug: pkg.slug },
		props: { pkg },
	}));
}

interface Props {
	pkg: TourPackage;
}

const { pkg } = Astro.props;
const path = `/tour-packages/${pkg.slug}/`;
const sedanPrice = pkg.prices.find((p) => p.vehicle === "sedan")?.price ?? 0;
const durationLabel =
	pkg.durationNights > 0
		? `${pkg.durationDays} Days / ${pkg.durationNights} Nights`
		: "1 Day";

// Long package names drop the "(Sedan)" suffix to stay inside Google's
// ~75-char title display limit.
const fullTitle = `${pkg.name} — ${formatINR(sedanPrice)} (Sedan)`;
const title =
	fullTitle.length > 75 ? `${pkg.name} — ${formatINR(sedanPrice)}` : fullTitle;
const description = `${pkg.shortName} by cab from Bangalore: Sedan ${formatINR(sedanPrice)}, ${durationLabel}, ${pkg.sightsCovered.length} places${
	pkg.hideIncludedKm ? "" : `, ${pkg.includedKm} km included`
}. Fixed price, verified drivers. Call +91 70227 62929.`;

const priceRows = pkg.prices.map((entry) => {
	const rates = RATE_CARD[entry.vehicle];
	return {
		label: rates.label,
		capacity: rates.capacity,
		values: [
			formatINR(entry.price),
			`${formatINR(pkg.extraKmRate[entry.vehicle] ?? rates.outstationPerKm)}/km`,
		],
		highlight: entry.vehicle === "sedan",
	};
});

const routes = pkg.routeSlugs
	.map((slug) => ROUTES.find((r) => r.slug === slug))
	.filter((r): r is NonNullable<typeof r> => Boolean(r));

const related = pkg.relatedPackages
	.map((slug) => PACKAGES.find((p) => p.slug === slug))
	.filter((p): p is TourPackage => Boolean(p));

const waMessage = `Hi! I'd like to book the ${pkg.name} (Sedan ${formatINR(sedanPrice)}).`;
const bookHref = `/book/?type=tour&package=${encodeURIComponent(pkg.slug)}`;

const ogImg = pkg.image
	? await getImage({ src: pkg.image, width: 1200, format: "jpeg" })
	: null;

const tripSchema = {
	"@context": "https://schema.org",
	"@type": "TouristTrip",
	name: pkg.name,
	description: pkg.overview[0],
	url: `${SITE.url}${path}`,
	...(ogImg ? { image: new URL(ogImg.src, SITE.url).href } : {}),
	touristType: ["Family", "Couple", "Group"],
	provider: { "@id": `${SITE.url}/#business` },
	itinerary: {
		"@type": "ItemList",
		itemListElement: pkg.sightsCovered.map((sight, index) => ({
			"@type": "ListItem",
			position: index + 1,
			item: { "@type": "TouristAttraction", name: sight },
		})),
	},
	offers: {
		"@type": "AggregateOffer",
		lowPrice: String(sedanPrice),
		highPrice: String(Math.max(...pkg.prices.map((entry) => entry.price))),
		priceCurrency: "INR",
		offerCount: pkg.prices.length,
	},
};
---

<PageLayout
	{title}
	{description}
	{path}
	ogImage={pkg.image}
	trail={[
		{ name: "Tour Packages", href: "/tour-packages/" },
		{ name: pkg.shortName },
	]}
	{waMessage}
	{bookHref}
	ctaTitle={`Book the ${pkg.shortName} package`}
>
	<PageHero
		title={pkg.name}
		subtitle={pkg.overview[0]}
		chips={[
			{ icon: "lucide:calendar", label: durationLabel },
			{ icon: "lucide:wallet", label: `From ${formatINR(sedanPrice)}` },
			...(pkg.hideIncludedKm
				? []
				: [{ icon: "lucide:map-pin", label: `${pkg.includedKm} km included` }]),
		]}
		{bookHref}
		bookLabel="Book This Package"
		{waMessage}
	/>

	{
		pkg.gallery && pkg.gallery.length > 0 && (
			<section class="px-4 sm:px-6 lg:px-8 pt-10">
				<div class="max-w-5xl mx-auto grid grid-cols-2 gap-4">
					{pkg.gallery.map((photo) => (
						<Image
							src={photo}
							alt={pkg.name}
							widths={[480, 800]}
							sizes="(min-width: 1024px) 480px, 50vw"
							format="webp"
							quality={75}
							loading="lazy"
							class="aspect-[4/3] w-full rounded-xl border object-cover"
						/>
					))}
				</div>
			</section>
		)
	}

	<section class="py-12 px-4 sm:px-6 lg:px-8">
		<div class="max-w-5xl mx-auto">
			<h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-6">
				Package Price
			</h2>
			<FareTable
				caption={`${pkg.name} prices by vehicle`}
				columns={["Package price", "Extra km"]}
				rows={priceRows}
				footnotes={[
					pkg.hideIncludedKm
						? "Includes fuel, driver bata and all sightseeing transfers for the full day's itinerary."
						: `Includes ${pkg.includedKm} km, fuel, driver bata and all sightseeing transfers per the itinerary.`,
					"Full inclusions and exclusions are listed below.",
				]}
			/>
		</div>
	</section>

	<section class="py-12 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-orange-50 to-red-50 dark:from-stone-900 dark:to-stone-950">
		<div class="max-w-5xl mx-auto">
			<h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-4">
				Itinerary
			</h2>
			{
				pkg.overview.slice(1).map((paragraph) => (
					<p class="text-muted-foreground leading-relaxed mb-6">{paragraph}</p>
				))
			}
			<div class="space-y-8">
				{
					pkg.itinerary.map((day) => (
						<div class="rounded-xl border bg-card p-6">
							<h3 class="text-lg font-bold text-foreground mb-4">
								<span class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-orange-500 to-red-500 text-white text-sm font-bold w-16 h-7 mr-3">
									Day {day.day}
								</span>
								{day.title}
							</h3>
							<ol class="relative border-l-2 border-orange-200 dark:border-orange-900 ml-3 space-y-4">
								{day.stops.map((stop) => (
									<li class="pl-6 relative">
										<span class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-orange-500" />
										<div class="flex flex-wrap items-baseline gap-x-3">
											{stop.time && (
												<span class="text-xs font-bold text-orange-600 dark:text-orange-400 whitespace-nowrap">
													{stop.time}
												</span>
											)}
											<span class="font-medium text-foreground">
												{stop.place}
											</span>
										</div>
										{stop.note && (
											<p class="text-sm text-muted-foreground mt-0.5">
												{stop.note}
											</p>
										)}
									</li>
								))}
							</ol>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-12 px-4 sm:px-6 lg:px-8">
		<div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">
			<div>
				<h2 class="text-2xl font-bold text-foreground mb-4">Included</h2>
				<ul class="space-y-2">
					{
						pkg.inclusions.map((item) => (
							<li class="flex gap-2 text-muted-foreground">
								<Icon
									name="lucide:check-circle-2"
									class="h-5 w-5 text-green-500 flex-shrink-0 mt-0.5"
								/>
								{item}
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h2 class="text-2xl font-bold text-foreground mb-4">Not included</h2>
				<ul class="space-y-2">
					{
						pkg.exclusions.map((item) => (
							<li class="flex gap-2 text-muted-foreground">
								<Icon
									name="lucide:minus-circle"
									class="h-5 w-5 text-red-400 flex-shrink-0 mt-0.5"
								/>
								{item}
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="max-w-5xl mx-auto mt-10">
			<h2 class="text-2xl font-bold text-foreground mb-4">Places covered</h2>
			<div class="flex flex-wrap gap-2">
				{
					pkg.sightsCovered.map((sight) => (
						<span class="rounded-full border bg-card px-3 py-1 text-sm text-foreground">
							{sight}
						</span>
					))
				}
			</div>
			{
				routes.length > 0 && (
					<p class="text-sm text-muted-foreground mt-6">
						Just need the cab without the itinerary? See{" "}
						{routes.map((route, index) => (
							<>
								<a
									href={withBase(routePath(route.slug))}
									class="text-orange-500 hover:underline"
								>
									Bangalore to {route.name} taxi fares
								</a>
								{index < routes.length - 1 ? " and " : ""}
							</>
						))}
						.
					</p>
				)
			}
		</div>
	</section>

	<section class="py-12 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-orange-50/70 to-red-50/50 dark:from-stone-900 dark:to-stone-950">
		<div class="max-w-4xl mx-auto">
			<h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-8 text-center">
				{pkg.shortName} FAQs
			</h2>
			<FaqAccordion faqs={pkg.faqs} emitSchema group="package-faq" />
		</div>
	</section>

	{
		related.length > 0 && (
			<section class="py-12 px-4 sm:px-6 lg:px-8">
				<div class="max-w-5xl mx-auto">
					<h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-8">
						You might also like
					</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
						{related.map((relatedPkg) => (
							<PackageCard pkg={relatedPkg} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<script type="application/ld+json" set:html={JSON.stringify(tripSchema)} />
</PageLayout>
