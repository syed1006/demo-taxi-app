---
import "@fontsource-variable/inter";
import "@fontsource-variable/fraunces";
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { SITE } from "../data/site";
import JsonLd from "../components/seo/JsonLd.astro";

interface Props {
	title?: string;
	description?: string;
	/** Site-relative path of this page, e.g. "/bangalore-to-mysore-taxi/". */
	path?: string;
	/** Page-specific social image; falls back to the brand og.png. */
	ogImage?: ImageMetadata;
	noindex?: boolean;
}

const {
	title = SITE.title,
	description = SITE.description,
	path = "/",
	ogImage,
	noindex = false,
} = Astro.props;
// "/" in production; "/<repo>/" on github.io test deploys.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isTestDeploy = base !== "";
const canonical = new URL(`${base}${path}`, Astro.site);
// getImage src is already base-prefixed.
const og = ogImage
	? await getImage({ src: ogImage, width: 1200, height: 630, format: "jpeg" })
	: null;
const ogImageUrl = og
	? new URL(og.src, Astro.site)
	: new URL(`${base}/og.png`, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		{(isTestDeploy || noindex) && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href={`${base}/favicon-32x32.png`}
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href={`${base}/favicon-16x16.png`}
		/>
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}/site.webmanifest`} />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />

		<meta
			name="theme-color"
			content="#fbf7f0"
			media="(prefers-color-scheme: light)"
		/>
		<meta
			name="theme-color"
			content="#141110"
			media="(prefers-color-scheme: dark)"
		/>

		{/* Set .dark before first paint to avoid a theme flash. */}
		<script is:inline>
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem("theme");
				} catch {}
				if (theme !== "light" && theme !== "dark") {
					theme = matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light";
				}
				document.documentElement.classList.toggle("dark", theme === "dark");
			})();
		</script>

		<JsonLd />
	</head>
	<body>
		<slot />
	</body>
</html>
