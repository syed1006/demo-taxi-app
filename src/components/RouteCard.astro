---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { Route } from "../data/route-types";
import { routePath } from "../data/routes";
import { formatINR } from "../lib/fare";
import { waLink } from "../data/site";
import { withBase } from "../lib/url";

interface Props {
	route: Route;
	class?: string;
}

const { route, class: className = "" } = Astro.props;

const CATEGORY_ICONS: Record<string, string> = {
	hills: "lucide:mountain",
	heritage: "lucide:building",
	beach: "lucide:map-pin",
	waterfalls: "lucide:tree-pine",
	spiritual: "lucide:star",
	nature: "lucide:tree-pine",
	city: "lucide:building-2",
};
const categoryIcon = CATEGORY_ICONS[route.category] ?? "lucide:map-pin";
const href = withBase(routePath(route.slug));
const sedan = route.fares.sedan;
const waMessage = `Hi! I want to book a Bangalore to ${route.name} taxi (Sedan ${
	sedan.oneWay
		? `${formatINR(sedan.oneWay)} one-way`
		: `${formatINR(sedan.roundTrip)} round trip`
}).`;
---

<article
	class:list={[
		"group relative overflow-hidden rounded-lg border-2 bg-card text-card-foreground hover:shadow-2xl transition-all duration-500 hover:border-orange-200 dark:hover:border-orange-800 flex flex-col h-full",
		className,
	]}
>
	<a
		href={href}
		class="block flex-1"
		aria-label={`Bangalore to ${route.name} taxi fares`}
	>
		<div class="relative h-44 overflow-hidden">
			{
				route.image ? (
					<Image
						src={route.image}
						alt={`Bangalore to ${route.name} taxi`}
						widths={[400, 800]}
						sizes="320px"
						format="webp"
						quality={75}
						loading="lazy"
						class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
					/>
				) : (
					<div class="w-full h-full bg-gradient-to-br from-orange-500 via-red-500 to-pink-500 flex items-center justify-center">
						<Icon name={categoryIcon} class="h-14 w-14 text-white/70" />
					</div>
				)
			}
			{
				route.popular && (
					<span class="absolute top-3 right-3 rounded-full bg-orange-500 text-white text-xs font-semibold px-2.5 py-1">
						Popular
					</span>
				)
			}
			<span
				class="absolute top-3 left-3 inline-flex items-center rounded-full bg-white/90 text-gray-800 text-xs font-medium px-2.5 py-1 capitalize"
			>
				<Icon name={categoryIcon} class="h-3 w-3 mr-1" />
				{route.category}
			</span>
		</div>

		<div class="p-4 pb-0 space-y-3">
			<div>
				<h3 class="text-lg font-bold text-foreground group-hover:text-orange-500 transition-colors line-clamp-2">
					Bangalore to {route.name} Taxi
				</h3>
				<p class="text-sm text-muted-foreground line-clamp-2">{route.summary}</p>
			</div>

			<div class="flex items-center gap-4 text-xs text-muted-foreground">
				<span class="flex items-center gap-1">
					<Icon name="lucide:map-pin" class="h-3.5 w-3.5" />
					{route.distanceKm} km
				</span>
				<span class="flex items-center gap-1">
					<Icon name="lucide:clock" class="h-3.5 w-3.5" />
					~{route.durationHrs} hrs
				</span>
				<span class="flex items-center gap-1">
					<Icon name="lucide:star" class="h-3.5 w-3.5 text-yellow-500 icon-fill" />
					{route.rating}
				</span>
			</div>
		</div>
	</a>

	{/* Bottom block pinned so fares and buttons align across the grid. */}
	<div class="p-4 pt-3 mt-auto space-y-3">
		<div class="rounded-lg bg-muted px-3 py-2 grid grid-cols-2 gap-2">
			<div>
				<span class="block text-xs text-muted-foreground">One-way</span>
				<strong class="text-sm text-green-700 dark:text-green-400">
					{sedan.oneWay ? formatINR(sedan.oneWay) : "—"}
				</strong>
			</div>
			<div class="text-right">
				<span class="block text-xs text-muted-foreground">Round trip</span>
				<strong class="text-sm text-orange-600 dark:text-orange-300">
					{formatINR(sedan.roundTrip)}
				</strong>
			</div>
		</div>

		<div class="grid grid-cols-2 gap-2">
			<a
				href={waLink(waMessage)}
				target="_blank"
				rel="noopener"
				class="btn inline-flex items-center justify-center gap-1.5 rounded-md bg-green-500 hover:bg-green-600 text-white text-sm font-bold py-2.5 transition-colors"
			>
				<Icon name="lucide:message-circle" class="h-4 w-4" />
				Book Now
			</a>
			<a
				href={href}
				class="btn inline-flex items-center justify-center gap-1.5 rounded-md border-2 border-orange-500 text-orange-600 dark:text-orange-400 hover:bg-orange-500 hover:text-white text-sm font-bold py-2.5 transition-colors"
			>
				Fares & Details
			</a>
		</div>
	</div>
</article>
