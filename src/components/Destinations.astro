---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { DESTINATIONS, CATEGORY_ICONS } from "../data/destinations";
import { waLink } from "../data/site";

const sections = [
	{
		id: "weekend",
		title: "🏞️ Weekend Getaways",
		subtitle: "Perfect for short trips",
		data: DESTINATIONS.weekend,
		gradient: "from-blue-500 to-cyan-600",
	},
	{
		id: "extended",
		title: "🌲 Extended Trips",
		subtitle: "Multi-day adventures",
		data: DESTINATIONS.extended,
		gradient: "from-purple-500 to-violet-600",
	},
	{
		id: "bangalore",
		title: "🏙️ Within Bangalore",
		subtitle: "Explore the Garden City",
		data: DESTINATIONS.bangalore,
		gradient: "from-green-500 to-emerald-600",
	},
];

const customTripMessage =
	"Hi! I'd like to know about trips to destinations not listed on your website. Can you help me?";
---

<section
	id="destinations"
	class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-slate-50 to-gray-100 dark:from-slate-900 dark:to-gray-900 overflow-hidden"
>
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-12 sm:mb-16">
			<h2
				class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground mb-4 sm:mb-6 animate-fade-in-up"
			>
				Popular Destinations
			</h2>
			<p
				class="text-lg sm:text-xl text-muted-foreground max-w-3xl mx-auto animate-fade-in-up delay-200 px-4"
			>
				Discover amazing places around Bangalore with our reliable taxi
				service. From city attractions to hill stations!
			</p>
		</div>

		{
			sections.map((section) => (
				<div class="mb-16 sm:mb-20">
					<div class="flex items-center justify-between mb-6 sm:mb-8">
						<div>
							<h3
								class={`text-2xl sm:text-3xl font-bold bg-gradient-to-r ${section.gradient} bg-clip-text text-transparent mb-2`}
							>
								{section.title}
							</h3>
							<p class="text-muted-foreground">{section.subtitle}</p>
						</div>

						<div class="hidden sm:flex space-x-2">
							<button
								type="button"
								data-scroll="left"
								data-target={`rail-${section.id}`}
								data-amount="344"
								class="inline-flex items-center justify-center rounded-full border bg-background h-10 w-10 hover:bg-orange-100 dark:hover:bg-orange-900 transition-colors"
								aria-label={`Scroll ${section.subtitle} left`}
							>
								<Icon name="lucide:chevron-left" class="h-4 w-4" />
							</button>
							<button
								type="button"
								data-scroll="right"
								data-target={`rail-${section.id}`}
								data-amount="344"
								class="inline-flex items-center justify-center rounded-full border bg-background h-10 w-10 hover:bg-orange-100 dark:hover:bg-orange-900 transition-colors"
								aria-label={`Scroll ${section.subtitle} right`}
							>
								<Icon name="lucide:chevron-right" class="h-4 w-4" />
							</button>
						</div>
					</div>

					<div
						id={`rail-${section.id}`}
						class="flex space-x-6 overflow-x-auto scrollbar-hide pb-4 snap-x"
					>
						{section.data.map((destination) => {
							const categoryIcon =
								CATEGORY_ICONS[destination.category] ?? "lucide:map-pin";
							return (
								<article class="group relative overflow-hidden rounded-lg border-2 bg-card hover:shadow-2xl transition-all duration-500 hover:border-blue-200 dark:hover:border-blue-800 flex-shrink-0 w-80 snap-start">
									{destination.popular && (
										<span class="absolute top-4 right-4 rounded-full bg-orange-500 text-white text-xs font-semibold px-2.5 py-1 z-30 animate-pulse-soft">
											Popular
										</span>
									)}

									<div class="relative h-full min-h-[400px] overflow-hidden">
										<Image
											src={destination.image}
											alt={destination.name}
											width={800}
											widths={[400, 800]}
											sizes="320px"
											format="webp"
											quality={75}
											loading="lazy"
											class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
										/>

										<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20 z-20" />

										<div class="absolute top-4 left-4 z-30">
											<span class="inline-flex items-center rounded-full bg-white/90 text-gray-800 text-xs font-medium px-2.5 py-1">
												<Icon name={categoryIcon} class="h-3 w-3 mr-1" />
												{destination.category}
											</span>
										</div>

										<div class="absolute top-12 left-4 flex items-center bg-black/50 backdrop-blur-sm rounded-full px-2 py-1 z-30">
											<Icon
												name="lucide:star"
												class="h-3 w-3 text-yellow-400 icon-fill mr-1"
											/>
											<span class="text-white text-xs font-semibold">
												{destination.rating}
											</span>
										</div>

										<div class="absolute bottom-0 left-0 right-0 p-6 text-white z-30">
											<h4 class="text-xl font-bold text-white mb-2">
												{destination.name}
											</h4>
											<p class="text-white/90 text-sm leading-relaxed mb-4">
												{destination.description}
											</p>

											<div class="flex items-center justify-between text-sm text-white/80 mb-1">
												{destination.distance && (
													<span class="flex items-center">
														<Icon
															name="lucide:map-pin"
															class="h-4 w-4 mr-1"
														/>
														{destination.distance} included
													</span>
												)}
												{destination.duration && (
													<span class="flex items-center">
														<Icon name="lucide:clock" class="h-4 w-4 mr-1" />
														{destination.duration}
													</span>
												)}
											</div>

											{destination.additionalInfo && (
												<div class="flex flex-col justify-between text-sm text-white/80 mb-1">
													<div class="flex items-center justify-between">
														<span class="flex items-center">
															<Icon
																name="lucide:indian-rupee"
																class="h-4 w-4 mr-1"
															/>
															13/km after {destination.distance}
														</span>
														<span class="flex items-center">
															<Icon
																name="lucide:luggage"
																class="h-4 w-4 mr-1"
															/>
															3 bags
														</span>
													</div>
													<span class="flex items-center">
														<Icon
															name="lucide:user-round"
															class="h-4 w-4 mr-1"
														/>
														Driver bata included
													</span>
												</div>
											)}

											{(destination.oneWay || destination.roundTrip) && (
												<div class="bg-black/30 backdrop-blur-sm rounded-lg p-3 space-y-2">
													{destination.oneWay && (
														<div class="flex justify-between items-center">
															<span class="text-sm text-white/80">
																One Way:
															</span>
															<span class="font-bold text-green-400">
																{destination.oneWay}
															</span>
														</div>
													)}
													{destination.roundTrip && (
														<div class="flex justify-between items-center">
															<span class="text-sm text-white/80">
																Round Trip:
															</span>
															<span class="font-bold text-blue-400">
																{destination.roundTrip}
															</span>
														</div>
													)}
												</div>
											)}

											<a
												href="#booking-form"
												data-booking-type="outstation"
												class="btn mt-3 flex w-full items-center justify-center rounded-md bg-orange-500 hover:bg-orange-600 text-white font-semibold py-2.5 transition-all duration-300"
											>
												Book Now
												<Icon
													name="lucide:arrow-right"
													class="ml-2 h-4 w-4"
												/>
											</a>
										</div>
									</div>
								</article>
							);
						})}
					</div>

					<div class="flex justify-center mt-4 sm:hidden">
						<p class="text-xs text-muted-foreground">
							← Swipe to see more destinations →
						</p>
					</div>
				</div>
			))
		}

		<div class="text-center mt-12 sm:mt-16 animate-fade-in-up delay-500">
			<div
				class="bg-gradient-to-r from-orange-500 to-red-500 rounded-2xl p-8 sm:p-12 text-white"
			>
				<h3 class="text-2xl sm:text-3xl font-bold mb-4">
					Don't See Your Destination?
				</h3>
				<p class="text-lg mb-6 text-orange-100">
					We cover many more destinations! Contact us for custom trips and
					special packages.
				</p>
				<a
					href={waLink(customTripMessage)}
					target="_blank"
					rel="noopener"
					class="inline-block bg-white text-orange-500 hover:bg-orange-50 font-bold px-8 py-3 rounded-full hover:scale-105 transition-all duration-300"
				>
					Contact Us for Custom Trips
				</a>
			</div>
		</div>
	</div>
</section>
