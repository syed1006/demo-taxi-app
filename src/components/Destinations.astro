---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { ROUTES } from "../data/routes";
import { CITY_SIGHTS } from "../data/city-sights";
import { waLink } from "../data/site";
import { withBase } from "../lib/url";
import RouteCard from "./RouteCard.astro";

const rails = [
	{
		id: "weekend",
		title: "🏞️ Weekend Getaways",
		subtitle: "Perfect for short trips",
		routes: ROUTES.filter((route) => route.homepageRail === "weekend"),
	},
	{
		id: "extended",
		title: "🌲 Extended Trips",
		subtitle: "Multi-day adventures",
		routes: ROUTES.filter((route) => route.homepageRail === "extended"),
	},
];

const customTripMessage =
	"Hi! I'd like to know about trips to destinations not listed on your website. Can you help me?";
---

<section
	id="destinations"
	class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-slate-50 to-gray-100 dark:from-slate-900 dark:to-gray-900 overflow-hidden"
>
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-12 sm:mb-16">
			<h2
				class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground mb-4 sm:mb-6 animate-fade-in-up"
			>
				Popular Destinations
			</h2>
			<p
				class="text-lg sm:text-xl text-muted-foreground max-w-3xl mx-auto animate-fade-in-up delay-200 px-4"
			>
				Discover amazing places around Bangalore with our reliable taxi
				service. From city attractions to hill stations!
			</p>
		</div>

		{
			rails.map((rail) => (
				<div class="mb-16 sm:mb-20">
					<div class="flex items-center justify-between mb-6 sm:mb-8">
						<div>
							<h3 class="text-2xl sm:text-3xl font-bold text-foreground mb-2">
								{rail.title}
							</h3>
							<p class="text-muted-foreground">{rail.subtitle}</p>
						</div>

						<div class="hidden sm:flex space-x-2">
							<button
								type="button"
								data-scroll="left"
								data-target={`rail-${rail.id}`}
								data-amount="344"
								class="inline-flex items-center justify-center rounded-full border bg-background h-10 w-10 hover:bg-orange-100 dark:hover:bg-orange-900 transition-colors"
								aria-label={`Scroll ${rail.subtitle} left`}
							>
								<Icon name="lucide:chevron-left" class="h-4 w-4" />
							</button>
							<button
								type="button"
								data-scroll="right"
								data-target={`rail-${rail.id}`}
								data-amount="344"
								class="inline-flex items-center justify-center rounded-full border bg-background h-10 w-10 hover:bg-orange-100 dark:hover:bg-orange-900 transition-colors"
								aria-label={`Scroll ${rail.subtitle} right`}
							>
								<Icon name="lucide:chevron-right" class="h-4 w-4" />
							</button>
						</div>
					</div>

					<div
						id={`rail-${rail.id}`}
						class="flex space-x-6 overflow-x-auto scrollbar-hide pb-4 snap-x"
					>
						{rail.routes.map((route) => (
							<RouteCard route={route} class="flex-shrink-0 w-80 snap-start" />
						))}
					</div>

					<div class="flex justify-center mt-4 sm:hidden">
						<p class="text-xs text-muted-foreground">
							← Swipe to see more destinations →
						</p>
					</div>
				</div>
			))
		}

		<div class="mb-16 sm:mb-20">
			<div class="flex items-center justify-between mb-6 sm:mb-8">
				<div>
					<h3 class="text-2xl sm:text-3xl font-bold text-foreground mb-2">
						🏙️ Within Bangalore
					</h3>
					<p class="text-muted-foreground">
						Explore the Garden City with our
						<a
							href={withBase("/tour-packages/bangalore-city-darshan-1-day/")}
							class="text-orange-500 font-semibold hover:underline"
						>
							City Darshan day package
						</a>
					</p>
				</div>
				<div class="hidden sm:flex space-x-2">
					<button
						type="button"
						data-scroll="left"
						data-target="rail-city"
						data-amount="344"
						class="inline-flex items-center justify-center rounded-full border bg-background h-10 w-10 hover:bg-orange-100 dark:hover:bg-orange-900 transition-colors"
						aria-label="Scroll city sights left"
					>
						<Icon name="lucide:chevron-left" class="h-4 w-4" />
					</button>
					<button
						type="button"
						data-scroll="right"
						data-target="rail-city"
						data-amount="344"
						class="inline-flex items-center justify-center rounded-full border bg-background h-10 w-10 hover:bg-orange-100 dark:hover:bg-orange-900 transition-colors"
						aria-label="Scroll city sights right"
					>
						<Icon name="lucide:chevron-right" class="h-4 w-4" />
					</button>
				</div>
			</div>

			<div
				id="rail-city"
				class="flex space-x-6 overflow-x-auto scrollbar-hide pb-4 snap-x"
			>
				{
					CITY_SIGHTS.map((sight) => (
						<a
							href={withBase("/tour-packages/bangalore-city-darshan-1-day/")}
							class="group relative overflow-hidden rounded-lg border-2 bg-card hover:shadow-2xl transition-all duration-500 hover:border-orange-200 dark:hover:border-orange-800 flex-shrink-0 w-80 snap-start"
						>
							<div class="relative h-44 overflow-hidden">
								<Image
									src={sight.image}
									alt={sight.name}
									widths={[400, 800]}
									sizes="320px"
									format="webp"
									quality={75}
									loading="lazy"
									class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
								/>
								{sight.popular && (
									<span class="absolute top-3 right-3 rounded-full bg-orange-500 text-white text-xs font-semibold px-2.5 py-1">
										Popular
									</span>
								)}
							</div>
							<div class="p-4 space-y-2">
								<div class="flex items-center justify-between">
									<h4 class="text-lg font-bold text-foreground group-hover:text-orange-500 transition-colors">
										{sight.name}
									</h4>
									<span class="flex items-center gap-1 text-xs text-muted-foreground">
										<Icon
											name="lucide:star"
											class="h-3.5 w-3.5 text-yellow-500 icon-fill"
										/>
										{sight.rating}
									</span>
								</div>
								<p class="text-sm text-muted-foreground line-clamp-2">
									{sight.blurb}
								</p>
								<span class="text-sm font-semibold text-orange-500">
									Included in City Darshan →
								</span>
							</div>
						</a>
					))
				}
			</div>
		</div>

		<div class="text-center mt-12 sm:mt-16 animate-fade-in-up delay-500">
			<div
				class="bg-gradient-to-r from-orange-500 to-red-500 rounded-2xl p-8 sm:p-12 text-white"
			>
				<h3 class="text-2xl sm:text-3xl font-bold mb-4">
					Don't See Your Destination?
				</h3>
				<p class="text-lg mb-6 text-orange-100">
					We cover many more destinations! Contact us for custom trips and
					special packages.
				</p>
				<a
					href={waLink(customTripMessage)}
					target="_blank"
					rel="noopener"
					class="inline-block bg-white text-orange-500 hover:bg-orange-50 font-bold px-8 py-3 rounded-full hover:scale-105 transition-all duration-300"
				>
					Contact Us for Custom Trips
				</a>
			</div>
		</div>
	</div>
</section>
