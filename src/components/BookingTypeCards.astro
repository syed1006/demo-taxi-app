---
import { Icon } from "astro-icon/components";
import { SERVICES } from "../data/services";
import { SITE, waLink } from "../data/site";
import { withBase } from "../lib/url";

// One tap to book: every journey type goes straight to WhatsApp or a call.
// One-Way Drop leads the SERVICES registry, so it stays the first card.
const cards = SERVICES.map((service) => ({
	name: service.name,
	priceHook: service.priceHook,
	icon: service.icon,
	color: service.color,
	popular: service.popular,
	waMessage: service.waMessage,
	path: service.path,
}));
---

<section
	id="booking-types"
	class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-background"
>
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-8">
			<h2 class="text-2xl sm:text-3xl font-bold text-foreground mb-2">
				Book Your Ride — One Tap
			</h2>
			<p class="text-sm sm:text-base text-muted-foreground">
				Pick your journey and book straight on WhatsApp or a call. No forms,
				no sign-ups.
			</p>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
			{
				cards.map((card) => (
					<div class="rounded-xl border bg-card text-card-foreground hover:border-orange-200 dark:hover:border-orange-800 transition-all duration-200 hover:shadow-lg p-5">
						<div class="flex items-center gap-3 mb-4">
							<div
								class={`flex-shrink-0 w-11 h-11 rounded-full bg-gradient-to-r ${card.color} flex items-center justify-center`}
							>
								<Icon name={card.icon} class="h-5 w-5 text-white" />
							</div>
							<div class="min-w-0">
								<h3 class="font-bold text-foreground leading-tight flex items-center gap-2">
									{card.name}
									{card.popular && (
										<span class="rounded-full bg-orange-500 text-white text-[10px] px-1.5 py-0.5 font-semibold">
											Popular
										</span>
									)}
								</h3>
								<p class="text-sm text-orange-600 dark:text-orange-400 font-semibold">
									{card.priceHook}
								</p>
							</div>
						</div>

						<div class="grid grid-cols-2 gap-2">
							<a
								href={waLink(card.waMessage)}
								target="_blank"
								rel="noopener"
								class="inline-flex items-center justify-center gap-1.5 rounded-md bg-green-500 hover:bg-green-600 text-white text-sm font-bold py-2.5 transition-colors"
							>
								<Icon name="lucide:message-circle" class="h-4 w-4" />
								WhatsApp
							</a>
							<a
								href={`tel:${SITE.phoneE164}`}
								class="inline-flex items-center justify-center gap-1.5 rounded-md border-2 border-orange-500 text-orange-600 dark:text-orange-400 hover:bg-orange-500 hover:text-white text-sm font-bold py-2.5 transition-colors"
							>
								<Icon name="lucide:phone" class="h-4 w-4" />
								Call
							</a>
						</div>

						{card.path && (
							<a
								href={withBase(card.path)}
								class="block text-center text-xs text-muted-foreground hover:text-orange-500 mt-3 underline underline-offset-2"
							>
								See fares & details
							</a>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
