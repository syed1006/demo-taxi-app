---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { Vehicle } from "../data/vehicles";
import { SITE, waLink } from "../data/site";
import { VEHICLE_PAGES } from "../data/services";
import { withBase } from "../lib/url";

interface Props {
	vehicle: Vehicle;
}

const { vehicle } = Astro.props;
const carouselId = `carousel-${vehicle.id}`;
const waMessage = `Hi! I want to book a ${vehicle.name} (${vehicle.subtitle}). Please share the fare.`;
const detailsPath = VEHICLE_PAGES.find((entry) => entry.cab === vehicle.name)?.path;
---

<article
	class="group relative overflow-hidden rounded-lg border-2 bg-card text-card-foreground hover:shadow-2xl transition-all duration-500 hover:border-orange-200 dark:hover:border-orange-800 animate-slide-up flex-shrink-0 w-full"
>
	{
		vehicle.popular && (
			<span class="absolute top-4 right-4 rounded-full bg-orange-500 text-white text-xs font-semibold px-2.5 py-1 z-10 animate-pulse-soft">
				Most Popular
			</span>
		)
	}

	<div class="flex flex-col md:flex-row">
		{/* Image carousel: CSS scroll-snap, JS only drives the arrow buttons */}
		<div
			class={`relative flex-shrink-0 w-full md:w-80 h-48 sm:h-56 md:h-auto bg-gradient-to-br ${vehicle.color}`}
		>
			<div
				id={carouselId}
				class="flex h-full overflow-x-auto snap-x snap-mandatory scrollbar-hide"
			>
				{
					vehicle.images.map((image, index) => (
						<Image
							src={image}
							alt={`${vehicle.name} photo ${index + 1}`}
							width={640}
							widths={[400, 640]}
							sizes="(min-width: 768px) 320px, 100vw"
							format="webp"
							quality={80}
							loading="lazy"
							class="w-full h-full flex-shrink-0 snap-center object-contain p-4"
						/>
					))
				}
			</div>
			{
				vehicle.images.length > 1 && (
					<>
						<button
							type="button"
							data-scroll="left"
							data-target={carouselId}
							class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/30 hover:bg-white/50 backdrop-blur-sm p-1.5 text-white transition-colors"
							aria-label={`Previous ${vehicle.name} photo`}
						>
							<Icon name="lucide:chevron-left" class="h-5 w-5" />
						</button>
						<button
							type="button"
							data-scroll="right"
							data-target={carouselId}
							class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/30 hover:bg-white/50 backdrop-blur-sm p-1.5 text-white transition-colors"
							aria-label={`Next ${vehicle.name} photo`}
						>
							<Icon name="lucide:chevron-right" class="h-5 w-5" />
						</button>
					</>
				)
			}
		</div>

		<div class="flex-1 p-4 sm:p-6">
			<div class="mb-4">
				<div class="flex items-center space-x-4 mb-4">
					<div
						class={`w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-gradient-to-r ${vehicle.color} flex items-center justify-center shadow-lg`}
					>
						<Icon
							name={vehicle.icon}
							class="h-6 w-6 sm:h-8 sm:w-8 text-white"
						/>
					</div>
					<div>
						<h4 class="text-lg sm:text-xl font-bold">{vehicle.name}</h4>
						<span
							class="inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium"
						>
							{vehicle.subtitle}
						</span>
					</div>
				</div>
				<p class="text-sm leading-relaxed text-muted-foreground">
					{vehicle.description}
				</p>
			</div>

			<div class="space-y-4">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<div
						class="bg-secondary rounded-lg p-3 border border-border"
					>
						<div class="flex items-center justify-between mb-1">
							<div class="flex items-center space-x-2">
								<Icon name="lucide:plane" class="h-4 w-4 text-orange-500" />
								<span
									class="text-sm font-medium text-muted-foreground"
									>Airport</span
								>
							</div>
							<span class="text-lg font-bold text-orange-600 dark:text-orange-400"
								>{vehicle.pricing.airport}</span
							>
						</div>
						<p class="text-xs text-muted-foreground">
							One way pickup/drop
						</p>
					</div>

					{
						vehicle.pricing.hourly4 !== "Not Available" && (
							<div class="bg-secondary rounded-lg p-3 border border-border">
								<div class="flex items-center justify-between mb-1">
									<div class="flex items-center space-x-2">
										<Icon
											name="lucide:clock"
											class="h-4 w-4 text-orange-500"
										/>
										<span class="text-sm font-medium text-muted-foreground">
											4 Hour
										</span>
									</div>
									<span class="text-lg font-bold text-orange-600 dark:text-orange-400">
										{vehicle.pricing.hourly4}
									</span>
								</div>
								<p class="text-xs text-muted-foreground">
									40km included
								</p>
							</div>
						)
					}

					{
						vehicle.pricing.hourly8 !== "Not Available" && (
							<div class="bg-secondary rounded-lg p-3 border border-border">
								<div class="flex items-center justify-between mb-1">
									<div class="flex items-center space-x-2">
										<Icon
											name="lucide:clock"
											class="h-4 w-4 text-orange-500"
										/>
										<span class="text-sm font-medium text-muted-foreground">
											8 Hour
										</span>
									</div>
									<span class="text-lg font-bold text-orange-600 dark:text-orange-400">
										{vehicle.pricing.hourly8}
									</span>
								</div>
								<p class="text-xs text-muted-foreground">
									80km included
								</p>
							</div>
						)
					}

					<div
						class="bg-secondary rounded-lg p-3 border border-border"
					>
						<div class="flex items-center justify-between mb-1">
							<div class="flex items-center space-x-2">
								<Icon name="lucide:map-pin" class="h-4 w-4 text-orange-500" />
								<span
									class="text-sm font-medium text-muted-foreground"
									>Outstation</span
								>
							</div>
							<span class="text-lg font-bold text-orange-600 dark:text-orange-400"
								>₹{vehicle.pricing.outstation}/km</span
							>
						</div>
						<p class="text-xs text-muted-foreground">
							+ Driver bata: {vehicle.pricing.driverBata}
						</p>
					</div>
				</div>

				<ul class="grid grid-cols-2 gap-2">
					{
						vehicle.features.map((feature) => (
							<li class="flex items-center text-xs">
								<span
									class="w-1.5 h-1.5 bg-green-500 rounded-full mr-2 flex-shrink-0"
									aria-hidden="true"
								/>
								<span class="text-foreground">{feature}</span>
							</li>
						))
					}
				</ul>

				<div class="grid grid-cols-2 gap-3">
					<a
						href={waLink(waMessage)}
						target="_blank"
						rel="noopener"
						class="btn inline-flex items-center justify-center gap-2 rounded-md bg-green-500 hover:bg-green-600 text-white font-bold py-3 transition-colors"
					>
						<Icon name="lucide:message-circle" class="h-4 w-4" />
						Book {vehicle.name}
					</a>
					<a
						href={`tel:${SITE.phoneE164}`}
						class="btn inline-flex items-center justify-center gap-2 rounded-md border-2 border-orange-500 text-orange-600 dark:text-orange-400 hover:bg-orange-500 hover:text-white font-bold py-3 transition-colors"
					>
						<Icon name="lucide:phone" class="h-4 w-4" />
						Call to Book
					</a>
				</div>
				{
					detailsPath && (
						<a
							href={withBase(detailsPath)}
							class="block text-center text-xs text-muted-foreground hover:text-orange-500 underline underline-offset-2"
						>
							Full {vehicle.name} rates & details
						</a>
					)
				}
			</div>
		</div>
	</div>
</article>
