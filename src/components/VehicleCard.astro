---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { Vehicle } from "../data/vehicles";

interface Props {
	vehicle: Vehicle;
}

const { vehicle } = Astro.props;
const carouselId = `carousel-${vehicle.id}`;
---

<article
	class="group relative overflow-hidden rounded-lg border-2 bg-card text-card-foreground hover:shadow-2xl transition-all duration-500 hover:border-orange-200 dark:hover:border-orange-800 animate-slide-up flex-shrink-0 w-full"
>
	{
		vehicle.popular && (
			<span class="absolute top-4 right-4 rounded-full bg-orange-500 text-white text-xs font-semibold px-2.5 py-1 z-10 animate-pulse-soft">
				Most Popular
			</span>
		)
	}

	<div class="flex flex-col md:flex-row">
		{/* Image carousel: CSS scroll-snap, JS only drives the arrow buttons */}
		<div
			class={`relative flex-shrink-0 w-full md:w-80 h-48 sm:h-56 md:h-auto bg-gradient-to-br ${vehicle.color}`}
		>
			<div
				id={carouselId}
				class="flex h-full overflow-x-auto snap-x snap-mandatory scrollbar-hide"
			>
				{
					vehicle.images.map((image, index) => (
						<Image
							src={image}
							alt={`${vehicle.name} photo ${index + 1}`}
							width={640}
							widths={[400, 640]}
							sizes="(min-width: 768px) 320px, 100vw"
							format="webp"
							quality={80}
							loading="lazy"
							class="w-full h-full flex-shrink-0 snap-center object-contain p-4"
						/>
					))
				}
			</div>
			{
				vehicle.images.length > 1 && (
					<>
						<button
							type="button"
							data-scroll="left"
							data-target={carouselId}
							class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/30 hover:bg-white/50 backdrop-blur-sm p-1.5 text-white transition-colors"
							aria-label={`Previous ${vehicle.name} photo`}
						>
							<Icon name="lucide:chevron-left" class="h-5 w-5" />
						</button>
						<button
							type="button"
							data-scroll="right"
							data-target={carouselId}
							class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/30 hover:bg-white/50 backdrop-blur-sm p-1.5 text-white transition-colors"
							aria-label={`Next ${vehicle.name} photo`}
						>
							<Icon name="lucide:chevron-right" class="h-5 w-5" />
						</button>
					</>
				)
			}
		</div>

		<div class="flex-1 p-4 sm:p-6">
			<div class="mb-4">
				<div class="flex items-center space-x-4 mb-4">
					<div
						class={`w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-gradient-to-r ${vehicle.color} flex items-center justify-center shadow-lg`}
					>
						<Icon
							name={vehicle.icon}
							class="h-6 w-6 sm:h-8 sm:w-8 text-white"
						/>
					</div>
					<div>
						<h4 class="text-lg sm:text-xl font-bold">{vehicle.name}</h4>
						<span
							class="inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium"
						>
							{vehicle.subtitle}
						</span>
					</div>
				</div>
				<p class="text-sm leading-relaxed text-muted-foreground">
					{vehicle.description}
				</p>
			</div>

			<div class="space-y-4">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<div
						class="bg-blue-50 dark:bg-blue-950 rounded-lg p-3 border border-blue-200 dark:border-blue-800"
					>
						<div class="flex items-center justify-between mb-1">
							<div class="flex items-center space-x-2">
								<Icon name="lucide:plane" class="h-4 w-4 text-blue-600" />
								<span
									class="text-sm font-medium text-blue-700 dark:text-blue-300"
									>Airport</span
								>
							</div>
							<span class="text-lg font-bold text-blue-600"
								>{vehicle.pricing.airport}</span
							>
						</div>
						<p class="text-xs text-blue-600/80 dark:text-blue-400/80">
							One way pickup/drop
						</p>
					</div>

					{
						vehicle.pricing.hourly4 !== "Not Available" && (
							<div class="bg-green-50 dark:bg-green-950 rounded-lg p-3 border border-green-200 dark:border-green-800">
								<div class="flex items-center justify-between mb-1">
									<div class="flex items-center space-x-2">
										<Icon
											name="lucide:clock"
											class="h-4 w-4 text-green-600"
										/>
										<span class="text-sm font-medium text-green-700 dark:text-green-300">
											4 Hour
										</span>
									</div>
									<span class="text-lg font-bold text-green-600">
										{vehicle.pricing.hourly4}
									</span>
								</div>
								<p class="text-xs text-green-600/80 dark:text-green-400/80">
									40km included
								</p>
							</div>
						)
					}

					{
						vehicle.pricing.hourly8 !== "Not Available" && (
							<div class="bg-purple-50 dark:bg-purple-950 rounded-lg p-3 border border-purple-200 dark:border-purple-800">
								<div class="flex items-center justify-between mb-1">
									<div class="flex items-center space-x-2">
										<Icon
											name="lucide:clock"
											class="h-4 w-4 text-purple-600"
										/>
										<span class="text-sm font-medium text-purple-700 dark:text-purple-300">
											8 Hour
										</span>
									</div>
									<span class="text-lg font-bold text-purple-600">
										{vehicle.pricing.hourly8}
									</span>
								</div>
								<p class="text-xs text-purple-600/80 dark:text-purple-400/80">
									80km included
								</p>
							</div>
						)
					}

					<div
						class="bg-orange-50 dark:bg-orange-950 rounded-lg p-3 border border-orange-200 dark:border-orange-800"
					>
						<div class="flex items-center justify-between mb-1">
							<div class="flex items-center space-x-2">
								<Icon name="lucide:map-pin" class="h-4 w-4 text-orange-600" />
								<span
									class="text-sm font-medium text-orange-700 dark:text-orange-300"
									>Outstation</span
								>
							</div>
							<span class="text-lg font-bold text-orange-600"
								>₹{vehicle.pricing.outstation}/km</span
							>
						</div>
						<p class="text-xs text-orange-600/80 dark:text-orange-400/80">
							+ Driver bata: {vehicle.pricing.driverBata}
						</p>
					</div>
				</div>

				<ul class="grid grid-cols-2 gap-2">
					{
						vehicle.features.map((feature) => (
							<li class="flex items-center text-xs">
								<span
									class="w-1.5 h-1.5 bg-green-500 rounded-full mr-2 flex-shrink-0"
									aria-hidden="true"
								/>
								<span class="text-foreground">{feature}</span>
							</li>
						))
					}
				</ul>

				<a
					href="#booking-form"
					data-cab-type={vehicle.name}
					class="btn block w-full text-center rounded-md border bg-background font-semibold py-3 group-hover:bg-orange-500 group-hover:text-white group-hover:border-orange-500 transition-all duration-300 hover:shadow-lg"
				>
					Select {vehicle.name}
				</a>
			</div>
		</div>
	</div>
</article>
