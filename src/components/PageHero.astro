---
import { Icon } from "astro-icon/components";
import { SITE, waLink } from "../data/site";
import { withBase } from "../lib/url";

interface Chip {
	icon: string;
	label: string;
}

interface Props {
	title: string;
	subtitle?: string;
	chips?: Chip[];
	bookHref?: string;
	bookLabel?: string;
	waMessage?: string;
}

const {
	title,
	subtitle,
	chips = [],
	bookHref = "/book/",
	bookLabel = "Book Now",
	waMessage = "Hi! I'd like to book a cab. Can you help me?",
} = Astro.props;
---

<section
	class="bg-gradient-to-br from-orange-600 via-red-600 to-pink-600 text-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8"
>
	<div class="max-w-7xl mx-auto">
		<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-4">
			{title}
		</h1>
		{subtitle && <p class="text-lg sm:text-xl text-white/85 max-w-3xl mb-6">{subtitle}</p>}

		{
			chips.length > 0 && (
				<div class="flex flex-wrap gap-3 mb-8">
					{chips.map((chip) => (
						<span class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm border border-white/25 rounded-full px-4 py-1.5 text-sm font-semibold">
							<Icon name={chip.icon} class="h-4 w-4 text-orange-200" />
							{chip.label}
						</span>
					))}
				</div>
			)
		}

		<div class="flex flex-col sm:flex-row gap-4">
			<a
				href={waLink(waMessage)}
				target="_blank"
				rel="noopener"
				class="inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-3.5 rounded-full hover:scale-105 transition-all duration-300 shadow-xl"
			>
				<Icon name="lucide:message-circle" class="h-5 w-5" />
				{bookLabel} on WhatsApp
			</a>
			<a
				href={`tel:${SITE.phoneE164}`}
				class="inline-flex items-center justify-center gap-2 bg-white text-orange-600 hover:bg-orange-50 font-bold px-8 py-3.5 rounded-full hover:scale-105 transition-all duration-300 shadow-xl"
			>
				<Icon name="lucide:phone" class="h-5 w-5" />
				Call {SITE.phoneDisplay}
			</a>
		</div>
		<a
			href={withBase(bookHref)}
			class="inline-block mt-4 text-sm text-white/75 hover:text-white underline underline-offset-4"
		>
			Prefer a form? Book online →
		</a>
	</div>
</section>
