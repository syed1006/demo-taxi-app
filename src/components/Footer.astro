---
import { Icon } from "astro-icon/components";
import { SITE } from "../data/site";
import { SERVICES, VEHICLE_PAGES } from "../data/services";
import { ROUTES, routePath } from "../data/routes";
import { PACKAGES, packageTitle } from "../data/packages";
import { LOCALITIES } from "../data/localities";
import { withBase } from "../lib/url";

const year = new Date().getFullYear();

const topRoutes = [...ROUTES]
	.sort((a, b) => Number(b.popular) - Number(a.popular))
	.slice(0, 10);

const topPackages = [...PACKAGES]
	.sort((a, b) => Number(b.popular) - Number(a.popular))
	.slice(0, 8);

const companyLinks = [
	{ name: "About Us", href: "/about/" },
	{ name: "Travel Guides", href: "/guides/" },
	{ name: "Customer Reviews", href: "/reviews/" },
	{ name: "FAQs", href: "/faq/" },
	{ name: "Contact", href: "/contact/" },
	{ name: "Terms & Cancellation", href: "/terms/" },
	{ name: "Privacy Policy", href: "/privacy/" },
];
---

<footer class="bg-gradient-to-br from-stone-900 to-stone-950 text-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8">
			{/* Brand block spans 2 of 6 — "BangaloreUrbanCabs" is one long word
			    and overflows a 1/5 column on laptops. */}
			<div class="space-y-6 lg:col-span-2">
				<div class="flex items-center space-x-3">
					<div class="bg-gradient-to-r from-orange-500 to-red-500 rounded-full p-2">
						<Icon name="lucide:car" class="h-8 w-8 text-white" />
					</div>
					<div>
						<p class="text-2xl font-bold">{SITE.shortName}</p>
						<p class="text-orange-300">{SITE.tagline}</p>
					</div>
				</div>
				<p class="text-stone-300 leading-relaxed">
					Your trusted ride partner across Bangalore. Safe, reliable, and
					affordable taxi service available 24/7.
				</p>
				<address class="space-y-3 not-italic">
					<a
						href={`tel:${SITE.phoneE164}`}
						class="flex items-center space-x-3 text-stone-300 hover:text-orange-300 transition-colors"
					>
						<Icon name="lucide:phone" class="h-5 w-5 text-orange-400" />
						<span>{SITE.phoneDisplay}</span>
					</a>
					<a
						href={`mailto:${SITE.email}`}
						class="flex items-center space-x-3 text-stone-300 hover:text-orange-300 transition-colors"
					>
						<Icon name="lucide:mail" class="h-5 w-5 text-orange-400" />
						<span>{SITE.email}</span>
					</a>
					<div class="flex items-start space-x-3 text-stone-300">
						<Icon
							name="lucide:map-pin"
							class="h-5 w-5 text-orange-400 mt-1 flex-shrink-0"
						/>
						<span>
							{SITE.address.street}, {SITE.address.locality}
							<br />
							{SITE.address.region} {SITE.address.postalCode}
						</span>
					</div>
				</address>
				<a
					href={SITE.instagram}
					target="_blank"
					rel="noopener"
					class="inline-flex text-stone-300 hover:text-orange-300 transition-colors"
					aria-label="Follow us on Instagram"
				>
					<Icon name="lucide:instagram" class="h-5 w-5" />
				</a>
			</div>

			<nav class="space-y-6" aria-label="Services">
				<h2 class="text-xl font-semibold text-orange-300">Our Services</h2>
				<ul class="space-y-3">
					{
						SERVICES.map((service) => (
							<li>
								<a
									href={withBase(service.path)}
									class="text-stone-300 hover:text-orange-300 transition-colors"
								>
									{service.name}
								</a>
							</li>
						))
					}
					{
						VEHICLE_PAGES.slice(0, 4).map((vehicle) => (
							<li>
								<a
									href={withBase(vehicle.path)}
									class="text-stone-300 hover:text-orange-300 transition-colors"
								>
									{vehicle.name}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="space-y-6" aria-label="Tour packages">
				<h2 class="text-xl font-semibold text-orange-300">Tour Packages</h2>
				<ul class="space-y-3">
					{
						topPackages.map((pkg) => (
							<li>
								<a
									href={withBase(`/tour-packages/${pkg.slug}/`)}
									class="text-stone-300 hover:text-orange-300 transition-colors"
								>
									{packageTitle(pkg)}
								</a>
							</li>
						))
					}
					<li>
						<a
							href={withBase("/tour-packages/")}
							class="font-semibold text-orange-300 hover:text-orange-200 transition-colors"
						>
							All {PACKAGES.length} Tour Packages →
						</a>
					</li>
				</ul>
			</nav>

			<nav class="space-y-6" aria-label="Popular routes">
				<h2 class="text-xl font-semibold text-orange-300">Popular Routes</h2>
				<ul class="space-y-3">
					{
						topRoutes.map((route) => (
							<li>
								<a
									href={withBase(routePath(route.slug))}
									class="text-stone-300 hover:text-orange-300 transition-colors"
								>
									Bangalore to {route.name} Taxi
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="space-y-6" aria-label="Company">
				<h2 class="text-xl font-semibold text-orange-300">Company</h2>
				<ul class="space-y-3">
					{
						companyLinks.map((link) => (
							<li>
								<a
									href={withBase(link.href)}
									class="text-stone-300 hover:text-orange-300 transition-colors"
								>
									{link.name}
								</a>
							</li>
						))
					}
					<li>
						<a
							href={withBase("/book/")}
							class="inline-flex items-center rounded-md bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white font-semibold px-5 py-2.5 mt-2 transition-colors"
						>
							Book a Cab Now
						</a>
					</li>
				</ul>
			</nav>
		</div>
	</div>

	<div class="border-t border-stone-700 bg-stone-950">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
			<p class="text-xs text-stone-400 mb-4 text-center md:text-left">
				<span class="font-semibold text-stone-300">Areas we serve:</span>
				{
					LOCALITIES.map((locality, index) => (
						<>
							<a
								href={withBase(`/taxi-in-${locality.slug}/`)}
								class="hover:text-orange-300 transition-colors"
							>
								Taxi in {locality.name}
							</a>
							{index < LOCALITIES.length - 1 ? " · " : ""}
						</>
					))
				}
				· and all of Bengaluru
			</p>
			<div
				class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0"
			>
				<p class="text-stone-400 text-sm">
					© {year}
					{SITE.name}. All rights reserved. Made with ❤️ in Bangalore.
				</p>
				<div class="flex items-center space-x-1 text-sm text-stone-400">
					<Icon name="lucide:star" class="h-4 w-4 text-yellow-400 icon-fill" />
					<span>{SITE.rating}/5 Rating</span>
				</div>
			</div>
		</div>
	</div>
</footer>
