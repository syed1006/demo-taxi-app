---
interface FareTableRow {
	label: string;
	capacity?: string;
	values: string[];
	highlight?: boolean;
}

interface Props {
	caption?: string;
	columns: string[];
	rows: FareTableRow[];
	footnotes?: string[];
}

const { caption, columns, rows, footnotes = [] } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border">
	<table class="w-full text-sm">
		{caption && <caption class="sr-only">{caption}</caption>}
		<thead>
			<tr class="bg-muted text-left">
				<th class="px-4 py-3 font-semibold text-foreground">Vehicle</th>
				{
					columns.map((column) => (
						<th class="px-4 py-3 font-semibold text-foreground whitespace-nowrap">
							{column}
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr
						class:list={[
							"border-t",
							row.highlight && "bg-orange-50 dark:bg-orange-950/40",
						]}
					>
						<td class="px-4 py-3">
							<span class="font-medium text-foreground">{row.label}</span>
							{row.capacity && (
								<span class="block text-xs text-muted-foreground">
									{row.capacity} seater
								</span>
							)}
						</td>
						{row.values.map((value) => (
							<td class="px-4 py-3 font-semibold text-foreground whitespace-nowrap">
								{value}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
{
	footnotes.length > 0 && (
		<ul class="mt-3 space-y-1">
			{footnotes.map((note) => (
				<li class="text-xs text-muted-foreground">{note}</li>
			))}
		</ul>
	)
}
