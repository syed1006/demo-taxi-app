---
import { Icon } from "astro-icon/components";
import type { FaqItem } from "../data/faq";

interface Props {
	faqs: FaqItem[];
	/** Emit FAQPage JSON-LD for these items (one page should do this at most once). */
	emitSchema?: boolean;
	/** <details name> group so only one item opens at a time. */
	group?: string;
	openFirst?: boolean;
}

const { faqs, emitSchema = false, group = "faq", openFirst = true } = Astro.props;

const schema = emitSchema
	? {
			"@context": "https://schema.org",
			"@type": "FAQPage",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: { "@type": "Answer", text: faq.answer },
			})),
		}
	: null;
---

<div class="space-y-3 sm:space-y-4">
	{
		faqs.map((faq, index) => (
			<details
				class="faq-item rounded-lg border bg-card text-card-foreground hover:shadow-lg transition-all duration-300 hover:border-orange-200 dark:hover:border-orange-800 overflow-hidden"
				name={group}
				open={openFirst && index === 0}
			>
				<summary class="flex items-center justify-between gap-4 p-4 sm:p-5 min-h-[56px]">
					<h3 class="text-base sm:text-lg font-semibold text-foreground flex-1">
						{faq.question}
					</h3>
					<Icon
						name="lucide:chevron-down"
						class="faq-chevron h-4 w-4 sm:h-5 sm:w-5 text-orange-500 flex-shrink-0"
					/>
				</summary>
				<p class="px-4 sm:px-5 pb-4 sm:pb-5 text-muted-foreground leading-relaxed text-sm sm:text-base">
					{faq.answer}
				</p>
			</details>
		))
	}
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
