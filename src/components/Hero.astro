---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { SITE, waLink } from "../data/site";
import { PACKAGES } from "../data/packages";
import { formatINR } from "../lib/fare";
import { withBase } from "../lib/url";
import cityBg from "../assets/bg/city-bg.webp";

// Tour packages are the highest-demand product: the hero sells them
// directly. Popular packages lead; every slide books in one tap.
const featured = [...PACKAGES]
	.sort((a, b) => Number(b.popular) - Number(a.popular))
	.slice(0, 6)
	.map((pkg) => {
		const sedanPrice = pkg.prices.find((p) => p.vehicle === "sedan")?.price;
		return {
			pkg,
			sedanPrice,
			duration:
				pkg.durationNights > 0
					? `${pkg.durationDays} Days / ${pkg.durationNights} Night${pkg.durationNights > 1 ? "s" : ""}`
					: "1-Day Trip",
			highlights: pkg.sightsCovered.slice(0, 3).join(" · "),
			waMessage: `Hi! I'd like to book the ${pkg.name}${sedanPrice ? ` (Sedan ${formatINR(sedanPrice)})` : ""}.`,
		};
	});
---

<section
	id="hero"
	class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
	<Image
		src={cityBg}
		alt=""
		width={1920}
		widths={[640, 1024, 1600, 1920]}
		sizes="100vw"
		quality={70}
		format="webp"
		loading="eager"
		fetchpriority="high"
		class="absolute inset-0 h-full w-full object-cover"
	/>

	<div
		class="absolute inset-0 bg-gradient-to-br from-orange-600/85 via-red-600/75 to-pink-600/85 dark:opacity-90"
	>
	</div>

	<div
		class="relative z-10 text-center px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full pt-28 pb-16"
	>
		<div class="space-y-5">
			<p class="text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight">
				<span class="block">{SITE.shortName}</span>
				<span class="block text-orange-300 text-2xl sm:text-3xl md:text-4xl">{SITE.tagline}</span>
			</p>

			<h1 class="text-base sm:text-lg font-semibold text-white/90 max-w-2xl mx-auto">
				Tour Packages &amp; Taxi Service in Bangalore — Airport, Outstation &amp; Local Cabs
			</h1>

			{/* Package slider: each slide is a directly bookable tour. */}
			<div class="relative">
				<div
					id="hero-slider"
					class="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide rounded-2xl"
				>
					{
						featured.map(({ pkg, sedanPrice, duration, highlights, waMessage }, index) => (
							<div class="w-full flex-shrink-0 snap-center px-1 py-2">
								<div class="bg-white/15 backdrop-blur-md border border-white/25 rounded-2xl p-6 sm:p-10 shadow-2xl">
									{pkg.image ? (
										<Image
											src={pkg.image}
											alt={pkg.shortName}
											width={128}
											height={128}
											format="webp"
											quality={75}
											loading={index === 0 ? "eager" : "lazy"}
											class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4 rounded-full object-cover border-2 border-white/40 shadow-lg"
										/>
									) : (
										<div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4 rounded-full bg-gradient-to-r from-orange-400 to-red-600 flex items-center justify-center shadow-lg">
											<Icon name="lucide:map" class="h-8 w-8 text-white" />
										</div>
									)}
									<h2 class="text-2xl sm:text-4xl font-bold text-white mb-1">
										{pkg.shortName}
										{sedanPrice && (
											<span class="block sm:inline text-orange-300 text-xl sm:text-3xl sm:ml-2">
												from {formatINR(sedanPrice)}
											</span>
										)}
									</h2>
									<p class="text-white font-semibold text-sm sm:text-base mb-1">
										{duration} · {pkg.sightsCovered.length} places · {pkg.includedKm} km included
									</p>
									<p class="text-white/85 text-sm sm:text-base mb-6 max-w-xl mx-auto">
										{highlights}
									</p>
									<div class="flex flex-col sm:flex-row items-center justify-center gap-3">
										<a
											href={waLink(waMessage)}
											target="_blank"
											rel="noopener"
											class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-3.5 text-lg rounded-full shadow-xl hover:scale-105 transition-all duration-300"
										>
											<Icon name="lucide:message-circle" class="h-5 w-5" />
											Book on WhatsApp
										</a>
										<a
											href={`tel:${SITE.phoneE164}`}
											class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white text-orange-600 hover:bg-orange-50 font-bold px-8 py-3.5 text-lg rounded-full shadow-xl hover:scale-105 transition-all duration-300"
										>
											<Icon name="lucide:phone" class="h-5 w-5" />
											Call Now
										</a>
									</div>
									<a
										href={withBase(`/tour-packages/${pkg.slug}/`)}
										class="inline-block mt-4 text-sm text-white/75 hover:text-white underline underline-offset-4"
									>
										Full itinerary &amp; prices →
									</a>
								</div>
							</div>
						))
					}
				</div>

				<button
					type="button"
					data-hero-nav="-1"
					class="hidden sm:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1/2 items-center justify-center w-11 h-11 rounded-full bg-white/20 hover:bg-white/35 backdrop-blur-sm border border-white/30 text-white transition-colors"
					aria-label="Previous package"
				>
					<Icon name="lucide:chevron-left" class="h-5 w-5" />
				</button>
				<button
					type="button"
					data-hero-nav="1"
					class="hidden sm:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 items-center justify-center w-11 h-11 rounded-full bg-white/20 hover:bg-white/35 backdrop-blur-sm border border-white/30 text-white transition-colors"
					aria-label="Next package"
				>
					<Icon name="lucide:chevron-right" class="h-5 w-5" />
				</button>

				<div class="flex justify-center gap-2 mt-4" id="hero-dots">
					{
						featured.map(({ pkg }, index) => (
							<button
								type="button"
								data-hero-dot={index}
								class:list={[
									"h-2.5 rounded-full transition-all duration-300",
									index === 0 ? "w-6 bg-white" : "w-2.5 bg-white/50",
								]}
								aria-label={`Go to ${pkg.shortName}`}
							/>
						))
					}
				</div>
			</div>

			<p class="text-sm text-white/85">
				Also:
				<a href={withBase("/airport-taxi-bangalore/")} class="font-semibold text-white underline underline-offset-4 hover:text-orange-200">Airport taxi from ₹799</a>
				·
				<a href={withBase("/outstation-cabs-bangalore/")} class="font-semibold text-white underline underline-offset-4 hover:text-orange-200">Outstation cabs</a>
				·
				<a href={withBase("/hourly-cab-rental-bangalore/")} class="font-semibold text-white underline underline-offset-4 hover:text-orange-200">Hourly rental</a>
			</p>

			<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 pt-2">
				{
					[
						{ icon: "lucide:clock", label: "24/7 service" },
						{ icon: "lucide:shield-check", label: "Verified drivers" },
						{ icon: "lucide:star", label: `${SITE.rating}★ rated` },
						{ icon: "lucide:wallet", label: "No advance payment" },
					].map((chip) => (
						<span class="inline-flex items-center gap-1.5 text-sm font-medium text-white/85">
							<Icon name={chip.icon} class="h-4 w-4 text-orange-300" />
							{chip.label}
						</span>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	const slider = document.getElementById("hero-slider");
	const dots = [...document.querySelectorAll<HTMLElement>("[data-hero-dot]")];
	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (slider && dots.length > 0) {
		const count = dots.length;
		let index = 0;
		let paused = false;

		const goTo = (next: number, smooth = true) => {
			index = ((next % count) + count) % count;
			slider.scrollTo({
				left: index * slider.clientWidth,
				behavior: smooth && !reducedMotion ? "smooth" : "auto",
			});
		};

		const paint = () => {
			for (const [i, dot] of dots.entries()) {
				dot.classList.toggle("w-6", i === index);
				dot.classList.toggle("bg-white", i === index);
				dot.classList.toggle("w-2.5", i !== index);
				dot.classList.toggle("bg-white/50", i !== index);
			}
		};

		// Track manual swipes so autoplay continues from the right slide.
		slider.addEventListener(
			"scroll",
			() => {
				const nearest = Math.round(slider.scrollLeft / slider.clientWidth);
				if (nearest !== index) {
					index = nearest;
					paint();
				}
			},
			{ passive: true }
		);

		for (const dot of dots) {
			dot.addEventListener("click", () => {
				goTo(Number(dot.dataset.heroDot));
			});
		}
		for (const nav of document.querySelectorAll<HTMLElement>("[data-hero-nav]")) {
			nav.addEventListener("click", () => goTo(index + Number(nav.dataset.heroNav)));
		}

		for (const event of ["pointerenter", "touchstart", "focusin"]) {
			slider.addEventListener(event, () => (paused = true), { passive: true });
		}
		slider.addEventListener("pointerleave", () => (paused = false));

		if (!reducedMotion) {
			setInterval(() => {
				if (!paused && document.visibilityState === "visible") goTo(index + 1);
			}, 4500);
		}
	}
</script>
