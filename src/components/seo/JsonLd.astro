---
import { SITE } from "../../data/site";

// Sitewide business entity. Per-page schema (FAQPage, BreadcrumbList,
// Service, TouristTrip) is emitted by the components that render the
// corresponding visible content, referencing this @id.
const business = {
	"@context": "https://schema.org",
	"@type": ["LocalBusiness", "TaxiService"],
	"@id": `${SITE.url}/#business`,
	name: SITE.name,
	alternateName: SITE.shortName,
	url: SITE.url,
	telephone: SITE.phoneE164,
	email: SITE.email,
	image: `${SITE.url}/og.png`,
	address: {
		"@type": "PostalAddress",
		streetAddress: SITE.address.street,
		addressLocality: SITE.address.locality,
		addressRegion: SITE.address.region,
		postalCode: SITE.address.postalCode,
		addressCountry: SITE.address.country,
	},
	areaServed: {
		"@type": "City",
		name: "Bengaluru",
	},
	openingHoursSpecification: {
		"@type": "OpeningHoursSpecification",
		dayOfWeek: [
			"Monday",
			"Tuesday",
			"Wednesday",
			"Thursday",
			"Friday",
			"Saturday",
			"Sunday",
		],
		opens: "00:00",
		closes: "23:59",
	},
	sameAs: [SITE.instagram],
	priceRange: "₹₹",
};
---

<script type="application/ld+json" set:html={JSON.stringify(business)} />
