---
import { Icon } from "astro-icon/components";
import { FAQS } from "../data/faq";
import { withBase } from "../lib/url";
import FaqAccordion from "./FaqAccordion.astro";

/** Homepage FAQ teaser — the full list lives at /faq/. */
const teaser = FAQS.slice(0, 4);
---

<section
	id="faq"
	class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-background overflow-hidden"
>
	<div class="max-w-4xl mx-auto">
		<div class="text-center mb-10 sm:mb-12">
			<div class="flex items-center justify-center mb-4 sm:mb-6">
				<Icon
					name="lucide:help-circle"
					class="h-10 w-10 sm:h-12 sm:w-12 text-orange-500 mr-3 sm:mr-4"
				/>
				<h2
					class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground animate-fade-in-up"
				>
					Frequently Asked Questions
				</h2>
			</div>
			<p
				class="text-lg sm:text-xl text-muted-foreground animate-fade-in-up delay-200 px-4"
			>
				Got questions? We've got answers.
			</p>
		</div>

		<FaqAccordion faqs={teaser} group="home-faq" />

		<div class="text-center mt-8">
			<a
				href={withBase("/faq/")}
				class="inline-flex items-center gap-2 text-orange-500 font-semibold hover:underline"
			>
				See all FAQs
				<Icon name="lucide:arrow-right" class="h-4 w-4" />
			</a>
		</div>
	</div>
</section>
