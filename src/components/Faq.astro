---
import { Icon } from "astro-icon/components";
import { FAQS } from "../data/faq";
import { waLink } from "../data/site";

const message = "Hi! I have a question about your taxi services. Can you help me?";
---

<section
	id="faq"
	class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-background overflow-hidden"
>
	<div class="max-w-4xl mx-auto">
		<div class="text-center mb-12 sm:mb-16">
			<div class="flex items-center justify-center mb-4 sm:mb-6">
				<Icon
					name="lucide:help-circle"
					class="h-10 w-10 sm:h-12 sm:w-12 text-orange-500 mr-3 sm:mr-4 animate-bounce-in"
				/>
				<h2
					class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground animate-fade-in-up"
				>
					Frequently Asked Questions
				</h2>
			</div>
			<p
				class="text-lg sm:text-xl text-muted-foreground animate-fade-in-up delay-200 px-4"
			>
				Got questions? We've got answers! Find everything you need to know
				about our taxi services.
			</p>
		</div>

		<div class="space-y-3 sm:space-y-4">
			{
				FAQS.map((faq, index) => (
					<details
						class="faq-item rounded-lg border bg-card text-card-foreground hover:shadow-lg transition-all duration-300 animate-slide-up hover:border-orange-200 dark:hover:border-orange-800 overflow-hidden"
						style={`animation-delay: ${index * 50}ms`}
						name="faq"
						open={index === 0}
					>
						<summary class="flex items-center justify-between gap-4 p-4 sm:p-6 min-h-[60px]">
							<h3 class="text-base sm:text-lg font-semibold text-foreground flex-1">
								{faq.question}
							</h3>
							<Icon
								name="lucide:chevron-down"
								class="faq-chevron h-4 w-4 sm:h-5 sm:w-5 text-orange-500 flex-shrink-0"
							/>
						</summary>
						<p class="px-4 sm:px-6 pb-4 sm:pb-6 text-muted-foreground leading-relaxed text-sm sm:text-base">
							{faq.answer}
						</p>
					</details>
				))
			}
		</div>

		<div class="text-center mt-8 sm:mt-12 animate-fade-in-up delay-500">
			<p class="text-muted-foreground mb-4 text-sm sm:text-base">
				Still have questions?
			</p>
			<a
				href={waLink(message)}
				target="_blank"
				rel="noopener"
				class="inline-flex items-center rounded-md bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white font-semibold px-6 sm:px-8 py-2.5 sm:py-3 hover:scale-105 transition-all duration-300"
			>
				Contact Us on WhatsApp
			</a>
		</div>
	</div>
</section>
