---
import { Icon } from "astro-icon/components";
import { TESTIMONIALS, initials } from "../data/testimonials";
---

<section
	id="testimonials"
	class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-950 dark:to-indigo-950 overflow-hidden"
>
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-12 sm:mb-16">
			<h2
				class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground mb-4 sm:mb-6 animate-fade-in-up"
			>
				What Our Customers Say
			</h2>
			<p
				class="text-lg sm:text-xl text-muted-foreground max-w-3xl mx-auto animate-fade-in-up delay-200 px-4"
			>
				Don't just take our word for it — hear from thousands of satisfied
				customers across Bangalore
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
			{
				TESTIMONIALS.map((testimonial, index) => (
					<article
						class="rounded-lg border-2 bg-card text-card-foreground hover:shadow-2xl transition-all duration-500 hover:scale-105 animate-slide-up hover:border-blue-200 dark:hover:border-blue-800"
						style={`animation-delay: ${index * 100}ms`}
					>
						<div class="p-4 sm:p-6">
							<div class="flex items-center mb-3 sm:mb-4">
								<Icon
									name="lucide:quote"
									class="h-6 w-6 sm:h-8 sm:w-8 text-blue-500 mr-2 sm:mr-3"
								/>
								<div class="flex" aria-label={`${testimonial.rating} out of 5 stars`}>
									{Array.from({ length: testimonial.rating }).map((_, i) => (
										<Icon
											name="lucide:star"
											class="h-3 w-3 sm:h-4 sm:w-4 text-yellow-400 icon-fill animate-twinkle"
											style={`animation-delay: ${i * 100}ms`}
										/>
									))}
								</div>
							</div>

							<p class="text-muted-foreground mb-4 sm:mb-6 leading-relaxed italic text-sm sm:text-base">
								"{testimonial.text}"
							</p>

							<div class="flex items-center">
								<div
									class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-gradient-to-br from-blue-400 to-purple-500 text-white flex items-center justify-center font-semibold text-sm sm:text-base mr-3 sm:mr-4"
									aria-hidden="true"
								>
									{initials(testimonial.name)}
								</div>
								<div>
									<h3 class="font-semibold text-foreground text-sm sm:text-base">
										{testimonial.name}
									</h3>
									<p class="text-xs sm:text-sm text-muted-foreground">
										{testimonial.location}
									</p>
								</div>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
