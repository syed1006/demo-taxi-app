---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { SITE, waLink } from "../data/site";
import { withBase } from "../lib/url";
import logo from "../assets/logo.webp";

const headerWaMessage = "Hi! I'd like to book a cab. Can you help me?";

const navItems = [
	{ name: "Airport", href: withBase("/airport-taxi-bangalore/") },
	{ name: "Outstation", href: withBase("/outstation-cabs-bangalore/") },
	{ name: "Tour Packages", href: withBase("/tour-packages/") },
	{ name: "Tempo Traveller", href: withBase("/tempo-traveller-hire-bangalore/") },
];
---

<header
	class="fixed top-0 left-0 right-0 z-50 bg-background/90 backdrop-blur-md shadow-lg border-b border-border/50"
>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-20">
			<a href={withBase("/")} class="flex items-center gap-3" aria-label={`${SITE.name} — home`}>
				<Image
					src={logo}
					alt={`${SITE.name} logo`}
					height={96}
					densities={[1, 2]}
					loading="eager"
					class="h-12 w-auto"
				/>
				<span class="sr-only">{SITE.name}</span>
			</a>

			<nav class="hidden md:flex items-center space-x-8" aria-label="Main">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class="text-foreground hover:text-orange-500 transition-colors duration-200 font-medium"
						>
							{item.name}
						</a>
					))
				}
			</nav>

			<div class="hidden md:flex items-center space-x-4">
				<a
					href={`tel:${SITE.phoneE164}`}
					class="flex items-center space-x-2 text-sm text-muted-foreground hover:text-orange-500 transition-colors"
				>
					<Icon name="lucide:phone" class="h-4 w-4" />
					<span>{SITE.phoneDisplay}</span>
				</a>
				<button
					type="button"
					class="theme-toggle inline-flex items-center justify-center rounded-md p-2 hover:bg-accent transition-colors"
					aria-label="Toggle dark mode"
				>
					<Icon name="lucide:sun" class="h-5 w-5 dark:hidden" />
					<Icon name="lucide:moon" class="h-5 w-5 hidden dark:block" />
				</button>
				<a
					href={waLink(headerWaMessage)}
					target="_blank"
					rel="noopener"
					class="inline-flex items-center gap-2 rounded-md bg-green-500 hover:bg-green-600 text-white font-semibold px-6 py-2.5 transition-colors"
				>
					<Icon name="lucide:message-circle" class="h-4 w-4" />
					Book Now
				</a>
			</div>

			<div class="md:hidden flex items-center space-x-2">
				<button
					type="button"
					class="theme-toggle inline-flex items-center justify-center rounded-md p-2 hover:bg-accent transition-colors"
					aria-label="Toggle dark mode"
				>
					<Icon name="lucide:sun" class="h-5 w-5 dark:hidden" />
					<Icon name="lucide:moon" class="h-5 w-5 hidden dark:block" />
				</button>
				<button
					type="button"
					id="menu-toggle"
					class="inline-flex items-center justify-center rounded-md p-2 hover:bg-accent transition-colors"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<Icon name="lucide:menu" class="h-6 w-6" data-menu-icon="open" />
					<Icon
						name="lucide:x"
						class="h-6 w-6 hidden"
						data-menu-icon="close"
					/>
				</button>
			</div>
		</div>
	</div>

	<div
		id="mobile-menu"
		class="hidden md:hidden border-t border-border bg-background/95 backdrop-blur-md"
	>
		<nav class="px-4 py-6 flex flex-col space-y-4" aria-label="Mobile">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="text-lg font-medium text-foreground hover:text-orange-500 transition-colors py-1"
					>
						{item.name}
					</a>
				))
			}
			<div class="pt-4 border-t border-border space-y-4">
				<a
					href={`tel:${SITE.phoneE164}`}
					class="flex items-center space-x-2 text-muted-foreground"
				>
					<Icon name="lucide:phone" class="h-4 w-4" />
					<span>{SITE.phoneDisplay}</span>
				</a>
				<a
					href={waLink(headerWaMessage)}
					target="_blank"
					rel="noopener"
					class="block w-full text-center rounded-md bg-green-500 hover:bg-green-600 text-white font-semibold px-6 py-3 transition-colors"
				>
					Book on WhatsApp
				</a>
				<a
					href={withBase("/book/")}
					class="block w-full text-center text-sm text-muted-foreground hover:text-orange-500 underline underline-offset-2"
				>
					Prefer a form? Book online
				</a>
			</div>
		</nav>
	</div>
</header>

<script>
	// Theme toggle (the head script applied the initial theme pre-paint).
	for (const button of document.querySelectorAll(".theme-toggle")) {
		button.addEventListener("click", () => {
			const dark = document.documentElement.classList.toggle("dark");
			try {
				localStorage.setItem("theme", dark ? "dark" : "light");
			} catch {}
		});
	}

	// Mobile menu
	const toggle = document.getElementById("menu-toggle");
	const menu = document.getElementById("mobile-menu");

	const setOpen = (open: boolean) => {
		if (!toggle || !menu) return;
		menu.classList.toggle("hidden", !open);
		toggle.setAttribute("aria-expanded", String(open));
		toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		toggle
			.querySelector('[data-menu-icon="open"]')
			?.classList.toggle("hidden", open);
		toggle
			.querySelector('[data-menu-icon="close"]')
			?.classList.toggle("hidden", !open);
	};

	toggle?.addEventListener("click", () => {
		setOpen(menu?.classList.contains("hidden") ?? false);
	});

	// Close when a link inside is used, or on Escape.
	menu?.addEventListener("click", (event) => {
		if ((event.target as Element).closest("a")) setOpen(false);
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") setOpen(false);
	});
</script>
